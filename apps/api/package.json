{
	"name": "@blueflame/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run --reporter=verbose --passWithNoTests",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist .turbo node_modules"
	},
	"dependencies": {
		"@blueflame/shared": "*",
		"cors": "^2.8.5",
		"dotenv": "^17.2.4",
		"express": "^4.21.0",
		"jsonwebtoken": "^9.0.3",
		"jwks-rsa": "^3.2.2",
		"socket.io": "^4.8.3",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.0.0",
		"@types/supertest": "^6.0.3",
		"socket.io-client": "^4.8.3",
		"supertest": "^7.2.2",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	}
}
