# =============================================================================
# Blueflame Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=blueflame-rg
AZURE_LOCATION=eastus

# --- Azure Cosmos DB ---
# config.ts reads COSMOS_ENDPOINT / COSMOS_KEY / COSMOS_DATABASE (not COSMOS_DB_*)
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=blueflame

# --- Azure SignalR ---
AZURE_SIGNALR_CONNECTION_STRING=

# --- Azure Key Vault ---
AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/

# --- Azure Monitor / Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Microsoft Entra ID (Auth) ---
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Microsoft Foundry (Azure AI Foundry) ---
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=gpt-4o
FOUNDRY_SPEC_DEPLOYMENT=gpt-4o
FOUNDRY_PLANNER_DEPLOYMENT=gpt-4o

# --- Azure OpenAI (aliases for model-registry.ts) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Multi-Provider Model Routing (S12: ACAR σ-routing) ---
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# --- Foundry Model Deployments (σ-router defaults) ---
# Deployment names must match Azure AI Foundry deployment names.
# Phi-4 (Microsoft) — Routine tier: lightweight/cheap tasks
# Llama-3.3-70B-Instruct (Meta) — Standard tier: code generation
# o3-mini (OpenAI) — Complex tier: reasoning-heavy tasks
# Override per role/tier: SIGMA_ROUTER_<ROLE>_<TIER>_MODEL=<deployment-name>
# Example: SIGMA_ROUTER_BUILDER_ROUTINE_MODEL=Phi-4

# --- Azure DevOps (S15: CI/CD integration) ---
ADO_ORG_URL=
ADO_PAT=

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development
LOG_LEVEL=debug
