# =============================================================================
# Blueflame Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=blueflame-rg
AZURE_LOCATION=eastus

# --- Azure Cosmos DB ---
COSMOS_DB_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=blueflame

# --- Azure SignalR ---
AZURE_SIGNALR_CONNECTION_STRING=

# --- Azure Key Vault ---
AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/

# --- Azure Monitor ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Microsoft Entra ID (Auth) ---
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Microsoft Foundry ---
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development
LOG_LEVEL=debug
